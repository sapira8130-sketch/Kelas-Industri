<!-- About Me Section -->
<section id="about" class="section reveal">
  <div class="section-header">
    <span class="section-tag">// 01 &bull; WHO I AM</span>
    <h2 class="section-title">ABOUT ME</h2>
  </div>

  <div class="glass-card about-card" style="display: flex; flex-direction: column; gap: 32px;">
    <!-- Main Bio Paragraph -->
    <div class="about-text" style="font-size: 1.08rem; line-height: 1.85; color: #cbd5e1;">
      <p>
        <%= portfolio.profile ? portfolio.profile.aboutText : 'Halo! Aku Sapira, siswa SMK Jakarta Pusat 1 jurusan Rekayasa Perangkat Lunak (RPL). Aku senang mengubah ide menjadi produk nyata — dari desain sampai kode. Berpengalaman dalam merancang antarmuka menggunakan Figma serta mengembangkan website menggunakan HTML, CSS, JavaScript, dan Node.js. Selalu haus akan hal baru dan siap bekerja secara kolaboratif untuk menghasilkan project yang kreatif dan fungsional! 🚀' %>
      </p>
    </div>



    <!-- Achievement Section (Ref Emir Yafi Style) -->
    <div style="background: rgba(37, 99, 235, 0.12); border: 1px solid rgba(37, 99, 235, 0.3); padding: 20px 24px; border-radius: var(--radius-md); display: flex; align-items: center; gap: 16px;">
      <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(37, 99, 235, 0.25); display: flex; align-items: center; justify-content: center; color: #60a5fa; flex-shrink: 0; font-size: 1.4rem;">
        🏆
      </div>
      <div>
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.76rem; font-weight: 700; color: #60a5fa; letter-spacing: 0.1em; margin-bottom: 2px;">// ACHIEVEMENT</div>
        <h4 style="font-size: 1rem; font-weight: 700; color: #ffffff; margin-bottom: 2px;">Siswa Rekayasa Perangkat Lunak (RPL)</h4>
        <p style="font-size: 0.85rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace;">SMK Jakarta Pusat 1 &middot; 2024–2027</p>
      </div>
    </div>

    <!-- Quick Facts Grid (Ref Emir Yafi Style) -->
    <div>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; font-weight: 700; color: var(--accent-cyan); letter-spacing: 0.08em; margin-bottom: 14px;">// QUICK FACTS</div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
        <div class="highlight-item">
          <div class="highlight-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          </div>
          <div class="highlight-content">
            <h4>SCHOOL</h4>
            <p style="font-weight: 600; color: #ffffff; font-size: 0.88rem;"><%= portfolio.profile ? portfolio.profile.school : 'SMK JAKARTA PUSAT 1' %> - RPL</p>
          </div>
        </div>

        <div class="highlight-item">
          <div class="highlight-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="highlight-content">
            <h4>EMAIL</h4>
            <p style="font-weight: 600; color: #ffffff; font-size: 0.88rem;"><%= portfolio.contact ? portfolio.contact.email : 'Sapira.8130@smk.belajar.id' %></p>
          </div>
        </div>

        <div class="highlight-item">
          <div class="highlight-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="highlight-content">
            <h4>STATUS</h4>
            <p style="font-weight: 600; color: #34d399; font-size: 0.88rem;"><%= portfolio.profile ? portfolio.profile.status : 'Available For Learning & Collaboration' %></p>
          </div>
        </div>

        <div class="highlight-item">
          <div class="highlight-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="highlight-content">
            <h4>LOCATION</h4>
            <p style="font-weight: 600; color: #ffffff; font-size: 0.88rem;"><%= portfolio.profile ? portfolio.profile.location : 'Indonesia' %></p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
