<!-- About Me Section -->
<section id="about" class="section reveal">
  <div class="section-header">
    <span class="section-tag">// WHO I AM</span>
    <h2 class="section-title">ABOUT ME</h2>
  </div>

  <div class="glass-card about-card">
    <div class="about-text">
      <p>
        <%= portfolio.profile ? portfolio.profile.aboutText : 'Siswa SMK jurusan Rekayasa Perangkat Lunak (RPL) yang memiliki minat dalam bidang teknologi, UI/UX Design, dan Web Development. Berpengalaman dalam merancang antarmuka menggunakan Figma serta mengembangkan website menggunakan HTML, CSS, JavaScript, dan Node.js. Senang mempelajari hal-hal baru, mengembangkan kemampuan, dan bekerja secara kolaboratif untuk menghasilkan project yang kreatif, fungsional, dan mudah digunakan.' %>
      </p>
    </div>

    <div class="about-highlights">
      <div class="highlight-item">
        <div class="highlight-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <div class="highlight-content">
          <h4>Education Status</h4>
          <p>SMK JAKARTA PUSAT 1 — RPL (2024–2027)</p>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
        </div>
        <div class="highlight-content">
          <h4>Focus Areas</h4>
          <p>Full Stack Web Development, UI/UX Prototyping & Database Management</p>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="highlight-content">
          <h4>Work Ethic & Soft Skills</h4>
          <p>Teamwork, Problem Solving, Communication & Creative Design</p>
        </div>
      </div>
    </div>
  </div>
</section>
