<!-- Hero Section Widget -->
<section id="hero" class="section reveal">
  <div class="glass-card hero-widget">
    <!-- Left Hero Main Content -->
    <div class="hero-content">
      <div class="glass-pill accent-cyan">
        <span class="status-dot"></span>
        <span>HELLO, I'M</span>
      </div>

      <h1 class="hero-name"><%= portfolio.profile ? portfolio.profile.name : 'SAPIRA' %></h1>

      <div class="hero-role-badge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <span><%= portfolio.profile ? portfolio.profile.role : 'FULL STACK WEB DEVELOPER' %></span>
      </div>

      <p class="hero-subrole"><%= portfolio.profile ? portfolio.profile.subRole : 'Web Developer • UI/UX Designer • Software Engineering Student' %></p>

      <p class="hero-bio">
        <%= portfolio.profile ? portfolio.profile.shortBio : 'Software Engineering student passionate about building modern websites, web applications, and digital experiences through clean design and technology.' %>
      </p>

      <div class="hero-actions">
        <a href="#projects" class="glass-button glass-button-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          <span>View My Projects</span>
        </a>

        <a href="<%= portfolio.contact ? portfolio.contact.whatsappUrl : 'https://wa.me/6287821276807' %>" target="_blank" class="glass-button glass-button-whatsapp">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <span>Let's Talk</span>
        </a>

        <a href="#contact" class="glass-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <!-- Right Profile Info Glass Card -->
    <div class="profile-card">
      <div class="profile-avatar-wrapper">
        <img src="<%= portfolio.profile && portfolio.profile.avatar ? portfolio.profile.avatar : '/images/profile.jpg' %>" alt="Sapira Profile" class="profile-avatar" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=400&auto=format&fit=crop';">
      </div>

      <div class="profile-info">
        <h3 class="profile-school"><%= portfolio.profile ? portfolio.profile.school : 'SMK JAKARTA PUSAT 1' %></h3>
        <p class="profile-major"><%= portfolio.profile ? portfolio.profile.major : 'Rekayasa Perangkat Lunak' %></p>
        <span class="profile-period"><%= portfolio.profile ? portfolio.profile.educationPeriod : '2024 — 2027' %></span>
        
        <div style="margin-top: 12px;">
          <span class="glass-pill status-online" style="font-size: 0.78rem;">
            <span class="status-dot"></span>
            <span><%= portfolio.profile ? portfolio.profile.status : 'Available for Learning & Opportunities' %></span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
