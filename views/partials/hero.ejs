<!-- Hero Section — Asymmetric Two-Column Layout (Prominent Profile Photo Focal Point) -->
<section id="hero" class="hero-section reveal">
  <div class="glass-card hero-asymmetric-container">
    
    <!-- LEFT COLUMN: Typography, Content & CTAs -->
    <div class="hero-left-col">
      
      <!-- Availability Status Badge -->
      <div class="hero-status-pill">
        <span class="status-dot green-pulse"></span>
        <span class="status-text">TERSEDIA UNTUK PEMBELAJARAN & KOLABORASI</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-giant-title"><%= portfolio.profile ? portfolio.profile.name : 'Sapira' %></h1>

      <!-- Monospace Role -->
      <div class="hero-role-cyan">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <span><%= portfolio.profile ? portfolio.profile.role : 'FULL STACK WEB DEVELOPER' %></span>
      </div>

      <!-- Bio Description -->
      <p class="hero-bio-description">
        <%= portfolio.profile ? portfolio.profile.shortBio : 'Siswa Rekayasa Perangkat Lunak yang antusias dalam mengubah ide menjadi produk digital nyata — dari rancangan UI/UX sampai kode aplikasi web yang cepat, indah, dan intuitif.' %>
      </p>

      <!-- Info Pills Row -->
      <div class="hero-info-pills-row">
        <div class="info-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span><%= portfolio.profile ? portfolio.profile.school.toUpperCase() : 'SMK JAKARTA PUSAT 1' %> - REKAYASA PERANGKAT LUNAK</span>
        </div>
        
        <a href="mailto:<%= portfolio.contact ? portfolio.contact.email : 'Sapira.8130@smk.belajar.id' %>" class="info-pill info-pill-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span><%= portfolio.contact ? portfolio.contact.email : 'Sapira.8130@smk.belajar.id' %></span>
        </a>
      </div>

      <!-- Action Buttons Row -->
      <div class="hero-action-buttons-row">
        <a href="<%= portfolio.contact ? portfolio.contact.whatsappUrl : 'https://wa.me/6287821276807' %>" target="_blank" class="action-pill pill-whatsapp">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <span>WhatsApp (0878 2127 6807)</span>
        </a>

        <a href="<%= portfolio.contact ? portfolio.contact.githubUrl : 'https://github.com/sapira8130-sketch' %>" target="_blank" class="action-pill pill-github">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          <span>GitHub</span>
        </a>

        <a href="#contact" class="action-pill pill-contact">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          <span>Hubungi Saya</span>
        </a>
      </div>

      <!-- Tech Chips Row -->
      <div class="tech-marquee-wrapper" style="margin-top: 24px; margin-bottom: 0;">
        <div class="tech-marquee-content">
          <div class="tech-chip"><span class="chip-icon">⚡</span><span>Node.js</span></div>
          <div class="tech-chip"><span class="chip-icon">💛</span><span>JavaScript</span></div>
          <div class="tech-chip"><span class="chip-icon">🌐</span><span>HTML5</span></div>
          <div class="tech-chip"><span class="chip-icon">🎨</span><span>CSS3</span></div>
          <div class="tech-chip"><span class="chip-icon">🗄️</span><span>MySQL</span></div>
          <div class="tech-chip"><span class="chip-icon">🚀</span><span>Express</span></div>
          <div class="tech-chip"><span class="chip-icon">📱</span><span>Flutter</span></div>
          <div class="tech-chip"><span class="chip-icon">✨</span><span>Figma</span></div>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Large Premium Profile Photo Container (Focal Point) -->
    <div class="hero-right-col">
      <!-- Glow Aura Halo Behind Photo Container -->
      <div class="profile-photo-glow-halo"></div>

      <!-- Large Glass Photo Frame -->
      <div class="profile-photo-frame">
        <img 
          src="<%= portfolio.profile && portfolio.profile.avatar ? portfolio.profile.avatar : '/images/profile.jpg' %>" 
          alt="<%= portfolio.profile ? portfolio.profile.name : 'Sapira' %> Profile Photo" 
          class="hero-large-photo"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=600&auto=format&fit=crop';"
        >

        <!-- Glass Overlay Gradient Frame Accent -->
        <div class="photo-glass-overlay"></div>

        <!-- Floating Badge 1 (Online Status) -->
        <div class="floating-badge badge-status">
          <span class="status-dot green-pulse"></span>
          <span>ONLINE • AVAILABLE</span>
        </div>

        <!-- Floating Badge 2 (Location / School) -->
        <div class="floating-badge badge-info">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>INDONESIA • RPL</span>
        </div>
      </div>
    </div>

  </div>
</section>
