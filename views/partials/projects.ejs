<!-- Featured Projects Section - Stacked Overlapping Showcase -->
<section id="projects" class="section reveal">
  <div class="section-header">
    <span class="section-tag">// MY WORK</span>
    <h2 class="section-title">FEATURED PROJECTS</h2>
    <p class="section-desc">Kumpulan project nyata berbasis akademik & personal yang telah dikembangkan dengan fokus pada fungsionalitas dan kualitas antarmuka.</p>
  </div>

  <div class="stacked-projects-container">
    <% if (portfolio.projects) { %>
      <% portfolio.projects.forEach((project, index) => { %>
        <article class="glass-card stacked-project-card" style="--card-index: <%= index %>; z-index: <%= index + 1 %>;">
          <!-- Floating Category Badge -->
          <div class="stacked-category-badge">
            <span class="badge-pill">
              <span class="badge-dot"></span>
              <%= project.type || project.category %>
            </span>
          </div>

          <!-- Project Number Badge -->
          <span class="stacked-project-number"><%= project.number %></span>

          <div class="stacked-card-inner">
            <!-- Left Side: Project Image -->
            <div class="stacked-thumb-wrapper">
              <img src="<%= project.image %>" alt="<%= project.title %> Thumbnail" class="stacked-thumb" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=600&auto=format&fit=crop';">
              <div class="stacked-thumb-overlay"></div>
            </div>

            <!-- Right Side: Project Details & Content -->
            <div class="stacked-project-body">
              <div class="stacked-project-meta">
                <span class="stacked-category-name"><%= project.category %></span>
                <span class="stacked-meta-divider">•</span>
                <span class="stacked-date"><%= project.date %></span>
              </div>

              <h3 class="stacked-project-title"><%= project.title %></h3>
              <% if (project.subtitle) { %>
                <div class="stacked-project-subtitle"><%= project.subtitle %></div>
              <% } %>
              
              <p class="stacked-project-desc"><%= project.summary %></p>

              <!-- Problem & Solution Block (if present) -->
              <% if (project.problem || project.solution) { %>
                <div class="stacked-problem-solution-grid">
                  <% if (project.problem) { %>
                    <div class="stacked-info-box problem-box">
                      <div class="box-label">// PROBLEM</div>
                      <div class="box-text"><%= project.problem %></div>
                    </div>
                  <% } %>
                  <% if (project.solution) { %>
                    <div class="stacked-info-box solution-box">
                      <div class="box-label">// SOLUTION</div>
                      <div class="box-text"><%= project.solution %></div>
                    </div>
                  <% } %>
                </div>
              <% } %>

              <!-- Features (if present) -->
              <% if (project.features && project.features.length > 0) { %>
                <div class="stacked-features-wrapper">
                  <div class="stacked-sub-label">// KEY FEATURES</div>
                  <div class="stacked-features-list">
                    <% project.features.forEach(feature => { %>
                      <div class="stacked-feature-item">
                        <span class="feature-bullet">&bull;</span>
                        <span><%= feature %></span>
                      </div>
                    <% }); %>
                  </div>
                </div>
              <% } %>

              <!-- Tech Stack Badges -->
              <% if (project.tools && project.tools.length > 0) { %>
                <div class="stacked-tech-wrapper">
                  <div class="stacked-sub-label">TECHNOLOGIES</div>
                  <div class="project-tools">
                    <% project.tools.forEach(tool => { %>
                      <span class="tool-chip"><%= tool %></span>
                    <% }); %>
                  </div>
                </div>
              <% } %>

              <!-- Footer CTA Actions -->
              <div class="stacked-footer-actions">
                <a href="<%= project.githubUrl %>" target="_blank" class="glass-button stacked-cta-btn" aria-label="View Project Code for <%= project.title %>">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                  <span>Code Repos</span>
                </a>

                <a href="#" class="glass-button glass-button-primary stacked-cta-main" onclick="alert('Live Demo link placeholder'); return false;" aria-label="View Live Project <%= project.title %>">
                  <span>VIEW PROJECT</span>
                  <span class="cta-arrow">&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      <% }); %>
    <% } %>
  </div>
</section>

