<!-- Project Journey Timeline Section -->
<section id="journey" class="section reveal">
  <div class="section-header">
    <span class="section-tag">// MY PROGRESSION</span>
    <h2 class="section-title">PROJECT JOURNEY</h2>
    <p class="section-desc">Rekam jejak perkembangan skill dan karya pengembangan aplikasi web dari waktu ke waktu.</p>
  </div>

  <div class="glass-card">
    <div class="timeline">
      <% if (portfolio.projectJourney) { %>
        <% portfolio.projectJourney.forEach(item => { %>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            
            <div class="timeline-card">
              <div class="timeline-header">
                <div>
                  <h3 class="timeline-title"><%= item.title %></h3>
                  <span class="timeline-role"><%= item.role %></span>
                </div>

                <div style="display: flex; align-items: center; gap: 10px;">
                  <span class="glass-pill accent-cyan" style="font-size: 0.75rem;"><%= item.tag %></span>
                  <span class="timeline-date"><%= item.date %></span>
                </div>
              </div>

              <p class="timeline-desc"><%= item.description %></p>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>
