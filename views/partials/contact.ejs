<!-- Contact Section -->
<section id="contact" class="section reveal">
  <div class="section-header">
    <span class="section-tag">// GET IN TOUCH</span>
    <h2 class="section-title">LET'S CONNECT</h2>
    <p class="section-desc">Punya ide project, ingin berkolaborasi, atau sekadar ingin terhubung? Jangan ragu untuk menghubungi saya.</p>
  </div>

  <!-- Big Callout Card (Ref Emir Yafi Style) -->
  <div class="glass-card" style="margin-bottom: 28px; background: linear-gradient(135deg, rgba(37, 99, 235, 0.18), rgba(124, 58, 237, 0.18)); border-color: rgba(37, 99, 235, 0.35);">
    <h3 style="font-size: 1.35rem; font-weight: 800; color: #ffffff; margin-bottom: 6px;">Siap membangun project berikutnya bersama?</h3>
    <p style="font-size: 0.95rem; color: #cbd5e1; line-height: 1.6;">Pilih cara yang paling nyaman untuk terhubung — diskusi, kolaborasi belajar, atau sekadar bertukar ide tentang teknologi.</p>
  </div>

  <div class="contact-grid">
    <!-- Left Direct Contact Info Pills -->
    <div class="glass-card contact-info-card">
      <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff;">Contact Information</h3>

      <div class="contact-pills">
        <!-- WhatsApp -->
        <a href="<%= portfolio.contact ? portfolio.contact.whatsappUrl : 'https://wa.me/6287821276807' %>" target="_blank" class="contact-pill-item" style="border-color: rgba(37, 211, 102, 0.35); background: rgba(37, 211, 102, 0.08);">
          <div class="contact-pill-icon" style="color: #25d366; background: rgba(37, 211, 102, 0.15);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div class="contact-pill-content">
            <span style="color: #25d366; font-weight: 700; font-family: 'JetBrains Mono', monospace;">WHATSAPP (DIRECT CHAT)</span>
            <strong style="font-size: 1.05rem; font-family: 'JetBrains Mono', monospace;"><%= portfolio.contact ? portfolio.contact.phone : '0878 2127 6807' %></strong>
          </div>
        </a>

        <!-- Email -->
        <a href="<%= portfolio.contact ? portfolio.contact.emailUrl : 'mailto:Sapira.8130@smk.belajar.id' %>" class="contact-pill-item">
          <div class="contact-pill-icon" style="color: #38bdf8;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="contact-pill-content">
            <span style="font-family: 'JetBrains Mono', monospace;">EMAIL</span>
            <strong style="font-size: 0.95rem; font-family: 'JetBrains Mono', monospace;"><%= portfolio.contact ? portfolio.contact.email : 'Sapira.8130@smk.belajar.id' %></strong>
          </div>
        </a>

        <!-- GitHub -->
        <a href="<%= portfolio.contact ? portfolio.contact.githubUrl : 'https://github.com/sapira8130-sketch' %>" target="_blank" class="contact-pill-item">
          <div class="contact-pill-icon" style="color: #a78bfa;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </div>
          <div class="contact-pill-content">
            <span style="font-family: 'JetBrains Mono', monospace;">GITHUB</span>
            <strong style="font-size: 0.95rem; font-family: 'JetBrains Mono', monospace;"><%= portfolio.contact ? portfolio.contact.githubUser : 'sapira8130-sketch' %></strong>
          </div>
        </a>
      </div>
    </div>

    <!-- Right Interactive AJAX Contact Form -->
    <div class="glass-card">
      <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin-bottom: 18px;">Send a Message</h3>

      <div id="form-status" class="form-status"></div>

      <form id="contact-form" class="contact-form" novalidate>
        <div class="form-group">
          <label for="form-name" class="form-label">Your Name</label>
          <input type="text" id="form-name" name="name" class="form-input" placeholder="e.g. John Doe" required>
        </div>

        <div class="form-group">
          <label for="form-email" class="form-label">Your Email</label>
          <input type="email" id="form-email" name="email" class="form-input" placeholder="e.g. john@example.com" required>
        </div>

        <div class="form-group">
          <label for="form-subject" class="form-label">Subject</label>
          <input type="text" id="form-subject" name="subject" class="form-input" placeholder="e.g. Project Inquiry / Opportunity" required>
        </div>

        <div class="form-group">
          <label for="form-message" class="form-label">Message</label>
          <textarea id="form-message" name="message" class="form-textarea" placeholder="Write your message here..." required></textarea>
        </div>

        <button type="submit" id="submit-btn" class="glass-button glass-button-primary" style="width: 100%; margin-top: 8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          <span>Send Message</span>
        </button>
      </form>
    </div>
  </div>
</section>
