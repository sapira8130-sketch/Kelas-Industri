<!-- TopBar macOS Window Header Widget -->
<div class="topbar-widget glass">
  <div class="topbar-controls">
    <span class="mac-dot mac-red" title="Close"></span>
    <span class="mac-dot mac-yellow" title="Minimize"></span>
    <span class="mac-dot mac-green" title="Expand"></span>
  </div>
  
  <div class="topbar-title">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
    <span>PORTFOLIO // <%= portfolio.profile ? portfolio.profile.name.toUpperCase() : 'SAPIRA' %></span>
    <span class="topbar-address">https://www.sapira.dev</span>
  </div>

  <div class="topbar-actions">
    <a href="<%= portfolio.contact ? portfolio.contact.whatsappUrl : '#' %>" target="_blank" class="glass-pill accent-blue" style="text-decoration: none;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span>WhatsApp</span>
    </a>
    <span class="glass-pill status-online">
      <span class="status-dot"></span>
      <span>Online</span>
    </span>
  </div>
</div>
