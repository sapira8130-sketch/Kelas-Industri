<!-- TopBar macOS Window Header Widget (Ref Emir Yafi Style) -->
<div class="topbar-widget glass" style="margin-bottom: 32px; padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-pill); background: rgba(11, 16, 32, 0.85); backdrop-filter: blur(25px); border: 1px solid rgba(255, 255, 255, 0.15);">
  <!-- Left macOS dots + Brand -->
  <div class="topbar-controls" style="display: flex; align-items: center; gap: 8px;">
    <span class="mac-dot mac-red"></span>
    <span class="mac-dot mac-yellow"></span>
    <span class="mac-dot mac-green"></span>
    <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; font-weight: 600; color: #ffffff; margin-left: 8px; display: flex; align-items: center; gap: 6px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
      <%= portfolio.profile ? portfolio.profile.name.toUpperCase() : 'SAPIRA' %>
    </span>
  </div>
  
  <!-- Center Navigation Pills -->
  <div class="nav-pills-center" style="display: flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.05); padding: 4px; border-radius: var(--radius-pill); border: 1px solid rgba(255, 255, 255, 0.08);">
    <a href="#about" class="nav-pill-item" style="padding: 6px 18px; border-radius: var(--radius-pill); font-size: 0.86rem; font-weight: 600; color: #ffffff; text-decoration: none; background: rgba(255, 255, 255, 0.15);">Tentang</a>
    <a href="#projects" class="nav-pill-item" style="padding: 6px 18px; border-radius: var(--radius-pill); font-size: 0.86rem; font-weight: 500; color: var(--text-muted); text-decoration: none;">Proyek</a>
    <a href="#contact" class="nav-pill-item" style="padding: 6px 18px; border-radius: var(--radius-pill); font-size: 0.86rem; font-weight: 500; color: var(--text-muted); text-decoration: none;">Kontak</a>
  </div>

  <!-- Right Quick Action Icons -->
  <div class="topbar-actions" style="display: flex; align-items: center; gap: 14px;">
    <a href="#contact" style="color: var(--text-muted); transition: color 0.2s;" title="Pesan Pesan"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></a>
    <a href="<%= portfolio.contact ? portfolio.contact.whatsappUrl : 'https://wa.me/6287821276807' %>" target="_blank" style="color: #25d366;" title="WhatsApp Direct"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></a>
    <a href="<%= portfolio.contact ? portfolio.contact.githubUrl : 'https://github.com/sapira8130-sketch' %>" target="_blank" style="color: var(--text-muted);" title="GitHub"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg></a>
  </div>
</div>
