<!-- Services Section -->
<section id="services" class="section reveal">
  <div class="section-header">
    <span class="section-tag">// WHAT I DO</span>
    <h2 class="section-title">SERVICES & SOLUTIONS</h2>
    <p class="section-desc">Layanan pengembangan web dan perancangan antarmuka yang siap disesuaikan dengan kebutuhan project Anda.</p>
  </div>

  <div class="services-grid">
    <% if (portfolio.services) { %>
      <% portfolio.services.forEach(service => { %>
        <div class="glass-card service-card">
          <div class="service-icon">
            <% if (service.icon === 'globe') { %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <% } else if (service.icon === 'layout') { %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            <% } else if (service.icon === 'monitor') { %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <% } else { %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/></svg>
            <% } %>
          </div>

          <h3 class="service-title"><%= service.title %></h3>
          <p class="service-desc"><%= service.description %></p>
        </div>
      <% }); %>
    <% } %>
  </div>
</section>
