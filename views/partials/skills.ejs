<!-- Skills & Tech Stack Section -->
<section id="skills" class="section reveal">
  <div class="section-header">
    <span class="section-tag">// MY CAPABILITIES</span>
    <h2 class="section-title">SKILLS & TECH STACK</h2>
    <p class="section-desc">Teknologi, tools, dan metodologi yang digunakan dalam merancang dan mengembangkan solusi web fungsional.</p>
  </div>

  <div class="skills-grid">
    <!-- Web Development Card -->
    <div class="glass-card skill-category-card">
      <h3 class="skill-category-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <span>Web Development</span>
      </h3>
      <div class="skill-chips">
        <% if (portfolio.skills && portfolio.skills.webDevelopment) { %>
          <% portfolio.skills.webDevelopment.forEach(item => { %>
            <div class="skill-chip">
              <span><%= item.name %></span>
              <span class="chip-tag"><%= item.level %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Database Card -->
    <div class="glass-card skill-category-card">
      <h3 class="skill-category-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        <span>Database</span>
      </h3>
      <div class="skill-chips">
        <% if (portfolio.skills && portfolio.skills.database) { %>
          <% portfolio.skills.database.forEach(item => { %>
            <div class="skill-chip">
              <span><%= item.name %></span>
              <span class="chip-tag"><%= item.level %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Tools & Design Card -->
    <div class="glass-card skill-category-card">
      <h3 class="skill-category-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
        <span>Tools & Design</span>
      </h3>
      <div class="skill-chips">
        <% if (portfolio.skills && portfolio.skills.toolsAndDesign) { %>
          <% portfolio.skills.toolsAndDesign.forEach(item => { %>
            <div class="skill-chip">
              <span><%= item.name %></span>
              <span class="chip-tag"><%= item.level %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- UI/UX Specialties Card -->
    <div class="glass-card skill-category-card">
      <h3 class="skill-category-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        <span>UI/UX Specializations</span>
      </h3>
      <div class="skill-chips">
        <% if (portfolio.skills && portfolio.skills.uiux) { %>
          <% portfolio.skills.uiux.forEach(item => { %>
            <div class="skill-chip">
              <span><%= item %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Soft Skills Card -->
    <div class="glass-card skill-category-card">
      <h3 class="skill-category-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>Soft Skills</span>
      </h3>
      <div class="skill-chips">
        <% if (portfolio.skills && portfolio.skills.softSkills) { %>
          <% portfolio.skills.softSkills.forEach(item => { %>
            <div class="skill-chip">
              <span><%= item %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</section>
